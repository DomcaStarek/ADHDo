# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/adhdo_db

# Security & JWT
SECRET_KEY=super-secret-adhdo-jwt-key-change-in-production-2026-secure-random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
EMAIL_VERIFY_TOKEN_EXPIRE_HOURS=24

# Frontend & CORS
FRONTEND_URL=http://localhost:5173
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Storage
MAX_FILE_SIZE_MB=10
